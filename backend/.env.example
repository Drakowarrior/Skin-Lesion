# Production Backend Environment Variables Template (Phase 32)
# Copy this file to backend/.env and set deployment values. DO NOT commit real secrets to Git.

ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8001

# Production Model Architecture & Checkpoint Settings (ConvNeXt-Small Default)
# MODEL_ENGINE options: convnext (default, PyTorch) or resnet50 (legacy, TensorFlow)
MODEL_ENGINE=convnext
MODEL_PATH=models/production/convnext_small_skin_lesion_v1.pt
PRODUCTION_MODEL_URL=https://github.com/Drakowarrior/Skin-Lesion/releases/download/v1.0.0/convnext_small_skin_lesion_v1.pt

# CORS Configuration - Allowed Frontend Origins (comma-separated for multiple origins)
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://skin-lesion.vercel.app

# Maximum Upload File Size Limit in Bytes (Default: 10MB = 10485760 bytes)
MAX_UPLOAD_SIZE=10485760

# Observability & Metrics Authentication
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=your_secure_metrics_auth_token_here

# Server-Side AI Patient Guidance Assistant Configuration (Placeholders ONLY)
# Supported AI_PROVIDER options: groq, gemini, openai, rule_fallback
AI_PROVIDER=groq
AI_API_KEY=your_server_side_ai_api_key_here
AI_MODEL=qwen/qwen3.8-27b

