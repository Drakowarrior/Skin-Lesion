# Production Backend Environment Variables Template (Phase 32)
# Copy this file to backend/.env and set deployment values. DO NOT commit real secrets to Git.

ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Path to frozen ResNet50 Keras production model checkpoint
MODEL_PATH=models/production/resnet50_skin_lesion_v1.keras

# CORS Configuration - Allowed Frontend Origins (comma-separated for multiple origins)
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Maximum Upload File Size Limit in Bytes (Default: 10MB = 10485760 bytes)
MAX_UPLOAD_SIZE=10485760

# Server-Side AI Patient Guidance Assistant Configuration (Placeholders ONLY)
# Supported AI_PROVIDER options: gemini, openai, groq, rule_fallback
AI_PROVIDER=gemini
AI_API_KEY=your_server_side_ai_api_key_here
AI_MODEL=gemini-1.5-flash

